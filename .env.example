# --- Supabase (Project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used by sync scripts and for tables that clients must never read
# (market cache, Warframe Market session tokens). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Step 4: encryption of stored Warframe Market session tokens ---
# 32 random bytes, base64.   openssl rand -base64 32
WFM_TOKEN_ENCRYPTION_KEY=

# --- Step 6: screenshot -> stats (vision model) ---
ANTHROPIC_API_KEY=

# Optional: override the vision model (default claude-opus-5-5). Try a cheaper one after comparing accuracy.
RIVEN_OCR_MODEL=
